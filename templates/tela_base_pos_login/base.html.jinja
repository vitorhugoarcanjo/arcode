<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="author" content="Vitor Hugo Arcanjo Dias Pereira">

    <title>{% block titulo %}Vitor Hugo | Desenvolvedor Python/Flask{% endblock %}</title>
    <meta name="description" content="{% block descricao %}Portfólio de Vitor Hugo — Desenvolvedor Python/Flask focado em sistemas web sob medida.{% endblock %}">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- CSS GLOBAL (core + components) — gerado pelo build -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/global.min.css') }}">

    {% block css_extra %}{% endblock %}
</head>
<body>

    {% include 'components/navbar.html.jinja' %}

    <main>
        {% block conteudo %}{% endblock %}
    </main>

    {% include 'components/footer.html.jinja' %}

    <!-- JS GLOBAL — gerado pelo build -->
    <script src="{{ url_for('static', filename='js/global.min.js') }}" defer></script>

    {% block js_extra %}{% endblock %}
</body>
</html>