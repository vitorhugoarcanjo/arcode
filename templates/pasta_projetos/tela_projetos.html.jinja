{% extends 'tela_base_pos_login/base.html.jinja' %}

{% block titulo %}Projetos | Vitor Hugo{% endblock %}

{% block descricao %}Projetos reais desenvolvidos com Flask, PostgreSQL, SQLite e HTMX. Sistemas web sob medida em produção.{% endblock %}

{% block css_extra %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/modules/pasta_projetos/projetos.min.css') }}">
{% endblock %}

{% block conteudo %}

<!-- ==================== HERO ==================== -->
<section class="bloco bloco-proj-hero">
    <div class="container">
        <span class="proj-tag">Portfólio</span>
        <h1 class="proj-titulo">Meus projetos<span class="proj-ponto">.</span></h1>
        <p class="proj-subtitulo">
            Sistemas reais que unem <strong>desenvolvimento web</strong>,
            <strong>arquitetura modular</strong> e soluções práticas.
        </p>
    </div>
</section>

<!-- ==================== GRID ==================== -->
<section class="bloco bloco-proj-lista">
    <div class="container">

        <div class="proj-grid">
            {% for p in projetos %}
            <article class="proj-card">

                {% if p.imagens %}
                <div class="proj-card-carrossel" data-carrossel>
                    <div class="proj-carrossel-imagens">
                        {% for img in p.imagens %}
                        <img
                            src="{{ url_for('static', filename=img.src) }}"
                            alt="{{ img.alt }}"
                            class="proj-carrossel-img {% if loop.first %}active{% endif %}"
                            data-index="{{ loop.index0 }}"
                            data-src-full="{{ url_for('static', filename=img.src) }}"
                            data-alt-full="{{ img.alt }}"
                            loading="lazy"
                        >
                        {% endfor %}
                    </div>

                    {% if p.imagens|length > 1 %}
                    <button class="proj-carrossel-btn prev" data-carrossel-prev aria-label="Imagem anterior">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button class="proj-carrossel-btn next" data-carrossel-next aria-label="Próxima imagem">
                        <i class="fas fa-chevron-right"></i>
                    </button>

                    <div class="proj-carrossel-dots">
                        {% for img in p.imagens %}
                        <span class="proj-carrossel-dot {% if loop.first %}active{% endif %}" data-carrossel-dot="{{ loop.index0 }}"></span>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
                {% endif %}

                <div class="proj-card-conteudo">
                    <div class="proj-card-header">
                        <div class="proj-card-header-top">
                            <span class="proj-badge proj-badge-{{ p.badge_tipo }}">{{ p.badge }}</span>
                            <span class="proj-card-ano">{{ p.ano }}</span>
                        </div>
                        <h2>{{ p.nome }}</h2>
                        <span class="proj-card-categoria">{{ p.categoria }}</span>
                    </div>

                    <p class="proj-card-desc">{{ p.descricao }}</p>

                    <div class="proj-card-tech">
                        {% for t in p.tech %}
                        <span>{{ t }}</span>
                        {% endfor %}
                    </div>

                    <div class="proj-card-rodape">
                        {% if p.link %}
                        <a href="{{ p.link }}" target="_blank" rel="noopener noreferrer" class="btn-primary proj-btn">
                            {{ p.link_texto }} <i class="fas fa-external-link-alt"></i>
                        </a>
                        {% else %}
                        <span class="proj-btn-disabled">
                            <i class="fas fa-lock"></i> {{ p.link_texto }}
                        </span>
                        {% endif %}
                    </div>
                </div>

            </article>
            {% endfor %}
        </div>

        <!-- ==================== CTA FINAL ==================== -->
        <div class="proj-cta">
            <p>Tem um projeto em mente?</p>
            <a href="https://wa.me/5565999757941" target="_blank" rel="noopener noreferrer" class="btn-primary">
                <i class="fab fa-whatsapp"></i> Falar comigo
            </a>
        </div>

    </div>
</section>

<!-- ==================== MODAL DE IMAGEM ==================== -->
<div class="proj-modal" id="proj-modal" aria-hidden="true" role="dialog" aria-label="Visualização de imagem">
    <button class="proj-modal-close" id="proj-modal-close" aria-label="Fechar">
        <i class="fas fa-times"></i>
    </button>

    <button class="proj-modal-nav prev" id="proj-modal-prev" aria-label="Imagem anterior">
        <i class="fas fa-chevron-left"></i>
    </button>

    <div class="proj-modal-content">
        <img src="" alt="" id="proj-modal-img">
        <p class="proj-modal-caption" id="proj-modal-caption"></p>
    </div>

    <button class="proj-modal-nav next" id="proj-modal-next" aria-label="Próxima imagem">
        <i class="fas fa-chevron-right"></i>
    </button>
</div>

{% endblock %}

{% block js_extra %}
<script src="{{ url_for('static', filename='js/modules/pasta_projetos/carrossel.min.js') }}" defer></script>
<script src="{{ url_for('static', filename='js/modules/pasta_projetos/modal.min.js') }}" defer></script>
{% endblock %}